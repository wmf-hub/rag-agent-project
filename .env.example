# ============ 大模型（OpenAI 兼容接口） ============
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ============ 向量模型 ============
EMBEDDING_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# ============ Milvus ============
# 二选一：
# 1) 远程 Milvus（docker-compose 起的那套）：填 http://localhost:19530
MILVUS_URI=http://localhost:19530
# 2) 本地 milvus-lite 文件库：MILVUS_URI 留空，只填 MILVUS_DB_PATH
#    注意：faiss 无法写入含中文的路径，本地库必须放在纯 ASCII 路径下
# MILVUS_DB_PATH=E:/milvus_data/milvus.db
COLLECTION_NAME=knowledge_base

# ============ 混合检索（dense 向量 + BM25 关键词，再由 ranker 融合） ============
HYBRID_ENABLED=true
HYBRID_RANKER=rrf
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
BM25_TOKENIZER=jieba
CONTENT_MAX_LENGTH=8192

# ============ Rerank 模型（相对项目根目录） ============
RERANK_MODEL=app/rag/models/bge-reranker-base
# 精排相关度阈值（0~1），低于该值的候选直接丢弃；全部不相关时检索返回空。设 0 即关闭过滤
RERANK_SCORE_THRESHOLD=0.3

# ============ PostgreSQL（短期记忆 / LangGraph checkpointer / 长期记忆） ============
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=short_memory

# ============ 长期记忆（跨会话记住用户事实与偏好） ============
MEMORY_ENABLED=true
# 每轮注入 system prompt 的记忆条数上限
MEMORY_MAX_ITEMS=20

# ============ 稳定性 / 错误处理 ============
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
AGENT_TIMEOUT=90
AGENT_RECURSION_LIMIT=12

# ============ 服务运行（run.py 读取；生产用 0.0.0.0） ============
APP_HOST=127.0.0.1
APP_PORT=8000
# 开发时开热重载；注意 Windows 上必须靠 --reload 才会用 SelectorEventLoop（run.py 已处理）
APP_RELOAD=false

# ============ 日志 ============
LOG_LEVEL=INFO
# 单行格式，%(request_id)s 由 RequestIDMiddleware 注入
LOG_FORMAT=%(asctime)s %(levelname)-7s [%(request_id)s] %(name)s: %(message)s

# ============ Postgres 连接池 ============
# 默认 max_size 会跟随 min_size（=4），SSE + 后台记忆抽取并发时容易 PoolTimeout
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=16
PG_POOL_TIMEOUT=10

# ============ 可观测性 ============
# 轻量 trace：每个节点/工具/LLM 调用的耗时都写进日志（带 request_id）
TRACE_ENABLED=true
# 启动时预热 rerank 模型，避免首个检索请求多等几秒
RERANK_PRELOAD=true